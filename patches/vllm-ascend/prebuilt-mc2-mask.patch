+def hoist_mc2_mask(enabled: bool) -> None:
+    """Serve a prebuilt mask per token width instead of rewriting one.
+
+    Both bounds are host integers fixed by the call site's width, so a decode
+    that replays the same widths every round rewrites the same values. Keeping
+    one filled buffer per bound pair removes those writes from the round and
+    still gives every captured graph a single stable address.
+    """
+    global _hoisted_mc2_masks
+    _hoisted_mc2_masks = {} if enabled else None
+
+
+def _prebuilt_mc2_mask(reserved, padded_num_tokens, num_actual_tokens):
+    key = (padded_num_tokens, num_actual_tokens)
+    mask = _hoisted_mc2_masks.get(key)
+    if mask is None:
+        mask = reserved[:padded_num_tokens].clone()
+        mask[:num_actual_tokens] = True
+        mask[num_actual_tokens:] = False
+        _hoisted_mc2_masks[key] = mask
+    return mask
 
 
