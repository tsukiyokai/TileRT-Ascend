+template <CubeFormat weight_format, class MatmulType>
+__aicore__ inline void ProjectGatePart(
+    MatmulType& mm, __gm__ int4b_t* rows, __gm__ int4b_t* weight,
+    __gm__ int32_t* product, int64_t count, int64_t part,
+    int64_t plane_stride)
+{
+    const int64_t matrix_rows = 2 * count;
+    const int64_t inner_begin = part * kGatePartInner;
+    GlobalTensor<int4b_t> a, b;
+    GlobalTensor<int32_t> c;
+    a.SetGlobalBuffer(Nibbles(rows, inner_begin),
+                      (matrix_rows - 1) * kHidden + kGatePartInner);
+    constexpr bool nz = weight_format == CubeFormat::NZ;
+    constexpr int64_t weight_span = nz
+        ? (kGateUp / 64 - 1) * kHidden * 64 + kGatePartInner * 64
+        : kGatePartInner * kGateUp;
+    b.SetGlobalBuffer(Nibbles(weight, GatePartWeightOffset(part, nz)),
+                      weight_span);
+    c.SetGlobalBuffer(product + part * plane_stride, matrix_rows * kGateUp);
+    // Preserve A's K6144 row stride and B's K6144 NZ block stride.
+    mm.SetOrgShape(matrix_rows, kGateUp, kHidden, kHidden, kGateUp);
+    mm.SetSingleShape(matrix_rows, kGateUp, kGatePartInner);
+    mm.SetTensorA(a);
+    mm.SetTensorB(b, false);
+    mm.IterateAll(c);
+    mm.End();
+}
+#endif
