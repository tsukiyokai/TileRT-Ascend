        {
          "line": 114,
          "text": "                verified.token_ids, verified.last_hidden, full_logits=False,"
        },
        {
          "line": 115,
          "text": "            )"
        },
        {
          "line": 116,
          "text": "            proposals, predictions = self.target.host_tokens("
