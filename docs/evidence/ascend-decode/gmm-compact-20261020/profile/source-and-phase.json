      "lines": [
        {
          "line": 1,
          "text": "\"\"\"FP32 logits from the existing CANN BF16 vocabulary projection.\"\"\""
        },
        {
          "line": 2,
          "text": ""
        },
        {
          "line": 3,
          "text": "from copy import copy"
        },
        {
          "line": 4,
          "text": "from types import MethodType"
        },
        {
          "line": 5,
          "text": ""
        },
        {
          "line": 6,
          "text": ""
        },
        {
          "line": 7,
          "text": "def fp32_projection(method, layer, hidden, bias=None):"
        },
        {
          "line": 8,
          "text": "    import torch"
        },
        {
          "line": 9,
          "text": ""
        },
        {
          "line": 10,
          "text": "    assert bias is None"
        },
        {
          "line": 11,
          "text": "    return torch.ops.aten.mm.dtype(hidden, layer.weight.t(), torch.float32)"
        },
        {
          "line": 12,
          "text": ""
        },
        {
          "line": 13,
          "text": ""
        },
        {
          "line": 14,
          "text": "def install_fp32_head(head, processor):"
        },
        {
          "line": 15,
          "text": "    \"\"\"Keep the BF16 TP16 weights and the original gather/vocabulary crop.\"\"\""
        },
        {
          "line": 16,
          "text": "    import torch"
        },
        {
          "line": 17,
          "text": "    import torch_npu"
        },
        {
          "line": 18,
          "text": "    from vllm.model_executor.layers.vocab_parallel_embedding import ("
        },
        {
          "line": 19,
          "text": "        UnquantizedEmbeddingMethod,"
        },
        {
          "line": 20,
          "text": "    )"
        },
        {
          "line": 21,
          "text": ""
        },
        {
          "line": 22,
          "text": "    assert isinstance(head.quant_method, UnquantizedEmbeddingMethod)"
        },
        {
          "line": 23,
          "text": "    assert processor.head_dtype in (None, torch.bfloat16)"
        },
        {
          "line": 24,
          "text": "    assert head.weight.dtype == torch.bfloat16"
        },
        {
          "line": 25,
          "text": "    assert torch_npu.get_npu_format(head.weight) == 2"
        },
        {
          "line": 26,
          "text": "    method = copy(head.quant_method)"
        },
        {
          "line": 27,
          "text": "    method.apply = MethodType(fp32_projection, method)"
        },
        {
          "line": 28,
          "text": "    head.quant_method = method"
        }
      ]
    },
    {
      "path": "/workspace/src/vllm-unified/vllm/model_executor/layers/logits_processor.py",
      "sha256": "35cf8235cb529ba2d37358fe9b9e5a29f40b5c3cbcc9e6750c8480c51bd7da83",
      "lines": [
        {
          "line": 122,
          "text": "    def _gather_logits(self, logits: torch.Tensor) -> torch.Tensor:"
        },
        {
          "line": 123,
          "text": "        \"\"\"gather/all-gather the logits tensor across model parallel group.\"\"\""
        },
        {
          "line": 124,
          "text": "        if self.use_all_gather:"
        },
        {
          "line": 125,
          "text": "            # Gather is not supported for some devices such as TPUs."
        },
        {
          "line": 126,
          "text": "            # Use all-gather instead."
        },
        {
          "line": 127,
          "text": "            # NOTE(woosuk): Here, the outputs of every device should not be None"
        },
        {
          "line": 128,
          "text": "            # because XLA requires strict SPMD among all devices. Every device"
        },
        {
          "line": 129,
          "text": "            # should execute the same operations after gathering the logits."
        },
        {
          "line": 130,
          "text": "            logits = tensor_model_parallel_all_gather(logits)"
        },
        {
          "line": 131,
          "text": "        else:"
        },
        {
          "line": 132,
          "text": "            # None may be returned for rank > 0"
        },
        {
          "line": 133,
          "text": "            logits = tensor_model_parallel_gather(logits)"
        },
        {
          "line": 134,
          "text": "        return logits"
        },
        {
          "line": 135,
          "text": ""
        },
        {
          "line": 136,
          "text": "    def _apply_head("
        },
        {
          "line": 137,
          "text": "        self,"
        },
        {
          "line": 138,
          "text": "        lm_head: VocabParallelEmbedding,"
        },
        {
          "line": 139,
          "text": "        hidden_states: torch.Tensor,"
        },
        {
          "line": 140,
          "text": "        embedding_bias: torch.Tensor | None,"
        },
        {
          "line": 141,
          "text": "    ) -> torch.Tensor:"
        },
        {
          "line": 142,
          "text": "        \"\"\"Project hidden states through the lm_head, honoring head_dtype.\"\"\""
        },
        {
          "line": 143,
          "text": "        if self.head_dtype is None or self.head_dtype == hidden_states.dtype:"
        },
        {
          "line": 144,
          "text": "            return lm_head.quant_method.apply("
        },
        {
          "line": 145,
          "text": "                lm_head, hidden_states, bias=embedding_bias"
        },
        {
          "line": 146,
          "text": "            )"
        },
        {
          "line": 147,
          "text": ""
        },
        {
          "line": 148,
          "text": "        # A quant config that excludes lm_head hands out UnquantizedLinearMethod"
        },
        {
          "line": 149,
          "text": "        # rather than UnquantizedEmbeddingMethod, so accept both: either way the"
        },
        {
          "line": 150,
          "text": "        # weight is plain and `lm_head.weight` can be cast directly."
        },
        {
          "line": 151,
          "text": "        if not isinstance("
        },
        {
          "line": 152,
          "text": "            lm_head.quant_method, (UnquantizedEmbeddingMethod, UnquantizedLinearMethod)"
        },
        {
          "line": 153,
          "text": "        ):"
        },
        {
          "line": 154,
          "text": "            raise ValueError("
        },
        {
          "line": 155,
          "text": "                \"A head_dtype different from the model dtype is only \""
        },
        {
          "line": 156,
          "text": "                \"supported for an unquantized lm_head.\""
        },
        {
          "line": 157,
          "text": "            )"
        },
        {
          "line": 158,
          "text": "        if ("
        },
        {
          "line": 159,
          "text": "            self.head_dtype == torch.float32"
        },
        {
          "line": 160,
          "text": "            and (current_platform.is_cuda() or current_platform.is_rocm())"
        },
        {
          "line": 161,
          "text": "            and hidden_states.is_cuda"
        },
        {
          "line": 162,
          "text": "        ):"
        },
        {
          "line": 163,
          "text": "            # Accumulate the projection directly into fp32. This avoids"
        },
        {
          "line": 164,
          "text": "            # materializing an fp32 copy of the lm_head weight on every step,"
        },
        {
          "line": 165,
          "text": "            # unlike casting both operands. `torch.mm(out_dtype=...)` only"
        },
        {
          "line": 166,
          "text": "            # supports fp32 output for fp16/bf16 inputs, and is only"
        },
        {
          "line": 167,
          "text": "            # implemented for CUDA and ROCm (the latter via the non-Lt GEMM"
        },
        {
          "line": 168,
          "text": "            # path); other platforms fall back to the cast path below."
        },
        {
          "line": 169,
          "text": "            flat = hidden_states.reshape(-1, hidden_states.shape[-1])"
        },
        {
          "line": 170,
          "text": "            logits = torch.mm(flat, lm_head.weight.t(), out_dtype=self.head_dtype)"
        },
        {
          "line": 171,
          "text": "            if embedding_bias is not None:"
        },
        {
          "line": 172,
          "text": "                logits = logits + embedding_bias.to(self.head_dtype)"
        },
        {
          "line": 173,
          "text": "            return logits.reshape(*hidden_states.shape[:-1], -1)"
        },
        {
          "line": 174,
          "text": "        return F.linear("
        },
        {
          "line": 175,
          "text": "            hidden_states.to(self.head_dtype),"
        },
        {
          "line": 176,
          "text": "            lm_head.weight.to(self.head_dtype),"
        },
        {
          "line": 177,
          "text": "            embedding_bias.to(self.head_dtype) if embedding_bias is not None else None,"
        },
        {
          "line": 178,
          "text": "        )"
        },
        {
          "line": 179,
          "text": ""
        },
        {
          "line": 180,
          "text": "    def _get_logits("
        },
        {
          "line": 181,
          "text": "        self,"
        },
        {
          "line": 182,
          "text": "        hidden_states: torch.Tensor,"
        },
        {
          "line": 183,
          "text": "        lm_head: VocabParallelEmbedding,"
        },
        {
          "line": 184,
          "text": "        embedding_bias: torch.Tensor | None,"
        },
        {
          "line": 185,
          "text": "        skip_gather: bool = False,"
        },
        {
          "line": 186,
          "text": "    ) -> torch.Tensor | None:"
        },
        {
          "line": 187,
          "text": "        # Get the logits for the next tokens."
        },
        {
          "line": 188,
          "text": "        logits = self._apply_head(lm_head, hidden_states, embedding_bias)"
        },
        {
          "line": 189,
          "text": "        if skip_gather:"
        },
        {
          "line": 190,
          "text": "            return logits"
        },
        {
          "line": 191,
          "text": ""
        },
        {
          "line": 192,
          "text": "        # Gather logits for TP"
        },
        {
          "line": 193,
          "text": "        if lm_head.tp_size > 1:"
        },
        {
          "line": 194,
          "text": "            logits = self._gather_logits(logits)"
        },
        {
          "line": 195,
          "text": ""
        },
        {
          "line": 196,
          "text": "        # Remove paddings in vocab (if any)."
        },
        {
          "line": 197,
          "text": "        if logits is not None:"
        },
        {
          "line": 198,
          "text": "            logits = logits[..., : self.org_vocab_size]"
        },
        {
          "line": 199,
          "text": "        return logits"
        },
        {
          "line": 200,
          "text": ""
        },
        {
          "line": 201,
          "text": "    def get_top_tokens("
        },
        {
          "line": 202,
          "text": "        self,"
        },
        {
          "line": 203,
          "text": "        lm_head: VocabParallelEmbedding,"
        },
        {
          "line": 204,
          "text": "        hidden_states: torch.Tensor,"
        },
        {
          "line": 205,
          "text": "        embedding_bias: torch.Tensor | None = None,"
        },
        {
          "line": 206,
          "text": "    ) -> torch.Tensor:"
        },
        {
          "line": 207,
          "text": "        \"\"\"Vocab-parallel argmax without all-gathering full logits."
        },
        {
          "line": 208,
          "text": ""
        },
        {
          "line": 209,
          "text": "        Each TP rank computes local argmax, then only the (value, index) pairs"
        },
        {
          "line": 210,
          "text": "        are gathered and reduced. Communication: O(batch * 2 * tp_size) vs"
        },
        {
          "line": 211,
          "text": "        O(batch * vocab_size)."
        },
        {
          "line": 212,
          "text": "        \"\"\""
        },
        {
          "line": 213,
          "text": "        if self.scale <= 0.0 and self.scale != 1.0:"
        },
        {
          "line": 214,
          "text": "            raise ValueError("
        },
        {
          "line": 215,
          "text": "                \"The local argmax reduction optimization is not supported for \""
        },
        {
          "line": 216,
          "text": "                \"non-positive logit scaling factors.\""
        },
        {
          "line": 217,
          "text": "            )"
        },
        {
          "line": 218,
          "text": "        tp_size = lm_head.tp_size"
        },
        {
          "line": 219,
          "text": ""
        },
        {
          "line": 220,
          "text": "        logits = self._apply_head(lm_head, hidden_states, embedding_bias)"
        },
        {
          "line": 221,
          "text": "        if self.soft_cap is not None:"
        },
        {
          "line": 222,
          "text": "            logits = torch.tanh(logits / self.soft_cap) * self.soft_cap"
        },
        {
          "line": 223,
          "text": "        if self.scale != 1.0:"
        },
        {
          "line": 224,
          "text": "            logits = logits * self.scale"
        },
        {
          "line": 225,
          "text": ""
        },
        {
          "line": 226,
          "text": "        # Mask out padding entries beyond org_vocab_size on this shard."
        },
        {
          "line": 227,
          "text": "        num_pad = lm_head.shard_indices.num_org_vocab_padding"
        },
        {
          "line": 228,
          "text": "        if num_pad > 0:"
        },
        {
          "line": 229,
          "text": "            logits[..., -num_pad:] = -float(\"inf\")"
        },
        {
          "line": 230,
          "text": ""
        },
        {
          "line": 231,
          "text": "        local_max_vals, local_max_indices = logits.max(dim=-1)"
        },
        {
          "line": 232,
          "text": ""
        },
        {
          "line": 233,
          "text": "        # Convert shard-local indices to global vocab indices."
        },
        {
          "line": 234,
          "text": "        vocab_start = lm_head.shard_indices.org_vocab_start_index"
        },
        {
          "line": 235,
          "text": "        global_indices = local_max_indices + vocab_start"
        },
        {
          "line": 236,
          "text": ""
        },
        {
          "line": 237,
          "text": "        if tp_size == 1:"
        },
        {
          "line": 238,
          "text": "            return global_indices"
        },
        {
          "line": 239,
          "text": ""
        },
        {
          "line": 240,
          "text": "        # All-gather (value, index) pairs, then reduce to global argmax."
        },
        {
          "line": 241,
          "text": "        # Use float32 to avoid bf16 precision loss on large vocab indices."
        },
        {
          "line": 242,
          "text": "        local_pair = torch.stack("
        },
        {
          "line": 243,
          "text": "            [local_max_vals.float(), global_indices.float()], dim=-1"
        },
        {
          "line": 244,
          "text": "        )"
        },
        {
          "line": 245,
          "text": "        # [batch, 2] -> [batch, 2 * tp_size]"
        },
        {
          "line": 246,
          "text": "        gathered = tensor_model_parallel_all_gather(local_pair, dim=-1)"
        },
        {
          "line": 247,
          "text": "        # [batch, tp_size, 2] where [:, :, 0]=values, [:, :, 1]=indices"
        },
        {
          "line": 248,
          "text": "        gathered = gathered.view(hidden_states.shape[0], tp_size, 2)"
        },
        {
          "line": 249,
          "text": "        max_rank_idx = gathered[:, :, 0].argmax(dim=-1, keepdim=True)"
        },
        {
          "line": 250,
          "text": "        top_tokens = gathered[:, :, 1].gather(dim=-1, index=max_rank_idx)"
        },
        {
          "line": 251,
          "text": "        return top_tokens.squeeze(-1).to(torch.int64)"
        }
      ]
    }
