        },
        {
          "line": 94,
          "text": "                self.draft.truncate(plan.main_start - 1)"
        },
        {
          "line": 95,
          "text": "                seeded = self.draft.forward("
        },
        {
          "line": 96,
          "text": "                    (plan.pending_token,), self.seed_parent_hidden,"
        },
