          "text": "            commit = self.state.resolve(plan, proposals, predictions)"
        },
        {
          "line": 120,
          "text": "            self.target.truncate(commit.main.retained)"
        },
        {
          "line": 121,
          "text": "            self.draft.truncate(commit.draft.retained)"
        },
        {
          "line": 122,
          "text": "            self.seed = self._seed(conditioned, commit.committed - 1)"
        },
        {
