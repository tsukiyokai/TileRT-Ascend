          "text": "                candidates.append(seed.token)"
        },
        {
          "line": 105,
          "text": "                if len(candidates) < plan.width:"
        },
        {
          "line": 106,
          "text": "                    chained = self.draft.forward("
        },
        {
          "line": 107,
          "text": "                        [seed.token], seed.recycle_hidden,"
        },
        {
          "line": 108,
          "text": "                        full_logits=False, external_indices=shared_indices,"
        },
        {
          "line": 109,
          "text": "                    )"
        },
        {
          "line": 110,
          "text": "                    seed = self._seed(chained, 0)"
        },
        {
          "line": 111,
          "text": "            verified = self.target.verify(candidates, full_logits=False)"
        },
        {
          "line": 112,
          "text": "            self.draft.truncate(plan.main_start)"
        },
        {
          "line": 113,
          "text": "            conditioned = self.draft.forward("
